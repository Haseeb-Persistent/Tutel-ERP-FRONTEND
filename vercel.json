{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/erp-front",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/main"
    }
  ],
  "functions": {
    "api/main.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "dist/erp-front/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/main"
    }
  ]
}